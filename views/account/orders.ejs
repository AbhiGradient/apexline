<%- include('../partials/head') %>
<div class="container section">
  <h1>Your Orders</h1>
  <% if (!orders.length) { %>
    <div class="empty-state">
      <h2>No orders yet</h2>
      <p class="muted">When you place an order, it will show up here.</p>
      <a class="btn btn-primary" href="/shop">Start Shopping</a>
    </div>
  <% } else { %>
    <% orders.forEach((o) => { %>
      <article class="order-card">
        <div class="order-card-head">
          <div><span class="muted">Order</span><strong><%= o.order_number %></strong></div>
          <div><span class="muted">Placed</span><strong><%= h.dateShort(o.placed_at) %></strong></div>
          <div><span class="muted">Total</span><strong><%= h.money(o.total) %></strong></div>
          <div><span class="muted">Ship to</span><strong><%= o.ship_name %></strong></div>
          <div><span class="status-pill <%= h.statusTone(o.status) %>"><%= h.statusLabel(o.status) %></span></div>
        </div>
        <div class="order-card-body">
          <div class="thumb-row">
            <% o.items.slice(0, 5).forEach((i) => { %><img src="<%= h.imageUrl(i.product_image) %>" alt="<%= i.product_name %>" loading="lazy"><% }) %>
          </div>
          <div class="row">
            <span class="muted"><%= o.items.length %> item<%= o.items.length === 1 ? '' : 's' %></span>
            <a class="btn btn-dark btn-sm" href="/account/orders/<%= o.order_number %>">View details</a>
          </div>
        </div>
      </article>
    <% }) %>
  <% } %>
</div>
<%- include('../partials/footer') %>