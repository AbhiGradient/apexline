<%- include('../partials/head') %>
<div class="container section" style="max-width:820px">
  <div class="success-mark"><%- include('../partials/icon', { name: 'shield' }) %></div>
  <h1>Order placed. Thank you!</h1>
  <p>Your order <strong><%= order.order_number %></strong> is <%= order.payment_status === 'paid' ? 'confirmed and paid' : 'confirmed. Please keep the amount ready for delivery' %>.</p>

  <section class="card">
    <h2>Items</h2>
    <% order.items.forEach((i) => { %>
      <div class="line-item">
        <img src="<%= h.imageUrl(i.product_image) %>" alt="<%= i.product_name %>" loading="lazy">
        <div class="grow"><strong><%= i.product_name %></strong><p class="muted" style="margin:0">Qty <%= i.quantity %></p></div>
        <strong><%= h.money(i.line_total) %></strong>
      </div>
    <% }) %>
    <p style="margin:14px 0 0"><strong>Total paid or payable: <%= h.money(order.total) %></strong> (<%= order.payment_method.toUpperCase() %>)</p>
  </section>

  <section class="card" style="margin-top:16px">
    <h2>Delivering to</h2>
    <p style="margin:0"><%= order.ship_name %><br><%= order.ship_line1 %><% if (order.ship_line2) { %>, <%= order.ship_line2 %><% } %><br><%= order.ship_city %>, <%= order.ship_state %> <%= order.ship_postal_code %></p>
    <p class="muted" style="margin:8px 0 0">Estimated delivery in 3 to 7 business days.</p>
  </section>

  <div class="row" style="margin-top:20px">
    <a class="btn btn-primary" href="/account/orders/<%= order.order_number %>">Track Order</a>
    <a class="btn btn-dark" href="/shop">Continue Shopping</a>
  </div>
</div>
<%- include('../partials/footer') %>