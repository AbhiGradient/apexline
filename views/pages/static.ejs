<%- include('../partials/head') %>
<div class="container section">
  <%- include('../partials/breadcrumbs', { crumbs: breadcrumbs }) %>
  <article class="prose">
    <h1><%= page.title %></h1>
    <p class="guide-meta">Last updated <%= page.updated %></p>
    <p class="lead"><%= page.intro %></p>
    <% page.sections.forEach((s) => { %>
      <section>
        <h2><%= s.h %></h2>
        <% (s.p || []).forEach((t) => { %><p><%= t %></p><% }) %>
        <% if (s.list) { %>
          <% if (s.ordered) { %><ol><% s.list.forEach((li) => { %><li><%= li %></li><% }) %></ol>
          <% } else { %><ul><% s.list.forEach((li) => { %><li><%= li %></li><% }) %></ul><% } %>
        <% } %>
      </section>
    <% }) %>
  </article>
</div>
<%- include('../partials/footer') %>