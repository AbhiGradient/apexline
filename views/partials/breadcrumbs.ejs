<nav aria-label="Breadcrumb">
  <ol class="breadcrumbs">
    <% crumbs.forEach((c, i) => { %>
      <li>
        <% if (i < crumbs.length - 1) { %><a href="<%= c.url %>"><%= c.name %></a>
        <% } else { %><span aria-current="page"><%= c.name %></span><% } %>
      </li>
    <% }) %>
  </ol>
</nav>