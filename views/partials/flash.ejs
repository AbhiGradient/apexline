<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="container">
    <div class="flash flash-<%= flash.type %>" role="status">
      <span><%= flash.message %></span>
      <button type="button" class="flash-close" aria-label="Dismiss message">&times;</button>
    </div>
  </div>
<% } %>