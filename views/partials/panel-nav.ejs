<%
const isAdminUser = user.role === 'admin';
const root = isAdminUser ? '/admin' : '/seller';
const tabs = isAdminUser
  ? [
  ['Dashboard', '/admin'],
  ['Products', '/admin/products'],
  ['Orders', '/admin/orders'],
  ['Users', '/admin/users'],
  ['Sellers', '/admin/sellers'],
  ['Categories', '/admin/categories'],
  ['Coupons', '/admin/coupons'],
  ['Messages', '/admin/messages'],
  ['Subscribers', '/admin/subscribers']
]
  : [['Dashboard', '/seller'], ['Products', '/seller/products'], ['Orders', '/seller/orders']];
const isOn = (href) => (href === root ? currentPath === root : currentPath === href || currentPath.startsWith(`${href}/`));
%>
<nav class="tabs-bar" aria-label="<%= isAdminUser ? 'Admin' : 'Seller' %> sections">
  <% tabs.forEach(([label, href]) => { %><a href="<%= href %>" class="<%= isOn(href) ? 'is-active' : '' %>"><%= label %></a><% }) %>
</nav>